            Alloy["Alloy<br/>수집기"]
            Prometheus[("Prometheus<br/>메트릭")]
            Loki[("Loki<br/>로그")]
            Tempo[("Tempo<br/>트레이스")]
            Pyroscope[("Pyroscope<br/>프로파일")]
            Grafana["Grafana<br/>대시보드"]
            Adapter["Custom Metrics Adapter<br/>활성 연결 기반 HPA"]
        end

