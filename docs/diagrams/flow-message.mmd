flowchart TB
    Client["클라이언트"]

    subgraph WSS ["WebSocket Service"]
        direction TB
        Session["Session"]
        Validate(["메시지 검증 · 도배 제한"])
        Hub["Hub"]
        Dedup{"중복 메시지?"}
        Drop(["중복 메시지 폐기"])
        Capacity{"저장 큐 등록 가능?"}
        Reject(["일시 오류 반환"])
        Sequence(["방 순번 발급"])
        Persist(["저장 작업 등록"])
        Fanout(["브로드캐스트"])

        subgraph Persistence ["비동기 저장 파이프라인"]
            direction TB
            Worker["Persistence Worker"]
            RetryWorker["Retry Worker"]
        end
    end

    subgraph ExternalServices ["외부 서비스"]
        direction LR
        ChatSvc["Chat Service"]
    end

    Client == "메시지 송신" ==> Session
    Session ==> Validate
    Validate ==> Hub
    Hub ==> Dedup
    Dedup -- "예" --> Drop
    Dedup == "아니오" ==> Capacity
    Capacity -- "아니오" --> Reject
    Reject --> Client
    Capacity == "예" ==> Sequence
    Sequence ==> Persist
    Persist ==> Fanout
    Fanout ==> Session
    Session == "메시지 수신" ==> Client
    Persist -.-> Worker
    Worker --> ChatSvc

    Worker -- "일시 실패" --> RetryWorker
    RetryWorker --> ChatSvc
