      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min(gochat:http_availability:ratio5m{namespace=~\"$namespace\",service=~\"$service\"}) * 100",
          "refId": "A"
        }
      ]
    },
