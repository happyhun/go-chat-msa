flowchart TB
    Client["클라이언트"]

    subgraph Control ["라우팅 제어 상태"]
        direction LR
        Membership[("라우팅 후보 목록<br/>주기 갱신과 만료")]
        Lease[("방 소유권<br/>활성 처리기 보호")]
        SeqFloor[("순번 기준값<br/>저장 실패 후 재사용 방지")]
    end

    subgraph WSGateway ["WS Gateway"]
        direction TB
        Ticket["일회성 티켓 소비"]
        GatewayRing["방 기준<br/>담당 인스턴스 선택"]
        Target{"선택된 담당<br/>인스턴스"}
        WatcherG["후보 목록 감시"]
    end

    subgraph Cluster ["WebSocket Service 클러스터"]
        direction LR

        subgraph PodA ["인스턴스 A"]
            direction TB
            RegistryA["후보 등록과 주기 갱신"]
            RingA["담당 인스턴스 자기검증"]
            ManagerA["방 관리자<br/>소유권 확보 · 이전 감지"]
            HubA["방 처리기<br/>순번 부여 · 브로드캐스트"]
        end

        subgraph PodB ["인스턴스 B"]
            direction TB
            RegistryB["후보 등록과 주기 갱신"]
            RingB["담당 인스턴스 자기검증"]
            ManagerB["방 관리자<br/>소유권 확보 · 이전 감지"]
            HubB["방 처리기<br/>순번 부여 · 브로드캐스트"]
        end
    end

    Client == "WebSocket 연결 요청" ==> Ticket
    Ticket ==> GatewayRing
    GatewayRing ==> Target
    Target -- "A" --> RingA
    Target -- "B" --> RingB

    RegistryA -- "후보 상태 갱신" --> Membership
    RegistryB -- "후보 상태 갱신" --> Membership
    Membership -- "변경 알림과 주기 재조회" --> WatcherG
    Membership -- "변경 알림과 주기 재조회" --> RingA
    Membership -- "변경 알림과 주기 재조회" --> RingB

    WatcherG --> GatewayRing
    RingA --> ManagerA
    RingB --> ManagerB

    ManagerA -- "확보 · 갱신 · 반납" --> Lease
    ManagerB -- "확보 · 갱신 · 반납" --> Lease
    ManagerA -- "시작 순번 결정에 사용" --> SeqFloor
    ManagerB -- "시작 순번 결정에 사용" --> SeqFloor

    ManagerA --> HubA
    ManagerB --> HubB

    RingA -. "담당이 아니면 새 티켓으로 재시도" .-> Client
    RingB -. "담당이 아니면 새 티켓으로 재시도" .-> Client
