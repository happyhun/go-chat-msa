flowchart TB
    subgraph ClientLayer ["클라이언트"]
        direction LR
        Browser["브라우저"]
    end

    subgraph Edge ["외부 진입 계층"]
        direction LR
        FE["Frontend<br/>정적 화면 제공"]
        AGW["API Gateway<br/>REST 계약<br/>인증 경계"]
        WSGW["WS Gateway<br/>일회성 티켓 발급<br/>방 기준 연결 라우팅"]
    end

    subgraph Core ["도메인 서비스"]
        direction LR
        UserSvc["User Service<br/>사용자 · 방 · 멤버십<br/>refresh token 상태"]
        ChatSvc["Chat Service<br/>메시지 저장<br/>이력과 누락 메시지 조회"]
        WSSvc["WebSocket Service<br/>방 처리기와 세션<br/>순번 부여 · 방 소유권"]
    end

    subgraph Data ["상태 저장소"]
        direction LR
        PG[("PostgreSQL<br/>사용자 · 방 · 멤버십")]
        MG[("MongoDB<br/>채팅 메시지")]
        RD[("Redis<br/>만료되는 인증 상태<br/>연결 티켓 · 라우팅 후보<br/>방 소유권 · 순번 기준값")]
    end

    Browser == "화면 요청" ==> FE
    Browser == "REST 요청" ==> AGW
    Browser == "WebSocket 연결 준비" ==> WSGW

    AGW -- "참여·퇴장 알림<br/>방 삭제 시 연결 정리" --> WSGW
    WSGW == "담당 인스턴스 선택<br/>WebSocket 프록시" ==> WSSvc

    AGW -- "사용자 · 방 요청 위임" --> UserSvc
    AGW -- "메시지 조회 위임" --> ChatSvc
    WSSvc -- "방 멤버십 확인" --> UserSvc
    WSSvc -- "메시지 저장 · 순번 조회" --> ChatSvc

    UserSvc --> PG
    UserSvc --> RD
    ChatSvc --> MG
    AGW --> RD
    WSGW --> RD
    WSSvc --> RD
