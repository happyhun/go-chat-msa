flowchart TB
    Client["Client"]

    subgraph Manager ["Manager"]
        direction TB
        ManagerLoop(("Manager Actor Loop"))
        PersistCh[/"Persist Channel"/]
        RetryCh[/"Retry Channel"/]
        RetryWorker("Retry Worker")

        subgraph WorkerPool ["Batch Worker Pool"]
            direction LR
            W1("Worker 1")
            W2("Worker 2")
        end
    end

    subgraph Hub ["Hub"]
        direction TB
        HubLoop(("Hub Actor Loop"))
        Idempotency["Dedup LRU"]
        Seq["room sequence_number"]
        Pending["pendingPersist"]
    end

    subgraph Session ["Session"]
        direction TB
        Socket(("WebSocket"))
        RP("Read Pump")
        RateLimit{"Rate Limiter"}

        WP("Write Pump")
        Buffer[/"Send Channel"/]
    end

    ChatService["Chat Service"]

    Client == "메시지 전송" ==> Socket
    Socket ==> RP
    RP ==> RateLimit
    RateLimit ==> HubLoop

    ManagerLoop -- "시스템 메시지 주입" --> HubLoop

    HubLoop -. "client_msg_id 중복 검사" .-> Idempotency
    HubLoop -- "persist slot reserve" --> PersistCh
    PersistCh -. "queue full" .-> RP
    RP -. "transient error<br/>sequence 증가 없음" .-> Socket
    HubLoop -. "slot 확보 후 sequence++" .-> Seq
    HubLoop ==>|"fan-out"| Buffer
    Buffer ==> WP
    WP ==> Socket
    Socket ==> Client

    HubLoop -- "저장 task + ack callback" --> PersistCh
    HubLoop -. "drain 시 0까지 대기" .-> Pending
    PersistCh --> WorkerPool
    WorkerPool -- "배치 저장" --> ChatService
    WorkerPool -. "성공 / idempotent success" .-> Pending
    WorkerPool -. "sequence conflict<br/>split-brain metric" .-> Pending
    WorkerPool -. "retryable 실패" .-> RetryCh
    RetryCh -. "재시도 대기" .-> RetryWorker
    RetryWorker -. "지수 백오프 재시도" .-> ChatService
    RetryWorker -. "성공 / 최종 실패 ack" .-> Pending
