flowchart TB
    Client["Client"]

    subgraph WSGateway ["WS Gateway"]
        direction TB
        Router["Router"]
        Hashring["Consistent Hashing"]
        Watcher_G["Membership Watcher"]
    end

    subgraph WS_Cluster ["WebSocket Service Deployment"]
        direction TB
        subgraph WSS1 ["Pod A"]
            Reg1["Registry (self heartbeat)"]
            Watcher1["Membership Watcher"]
            Ring1["Hash Ring (self-check)"]
            Router1["Router<br/>PrepareRegister before upgrade"]
            Manager1["Manager<br/>Room Lease · Sequence Floor"]
            Hub1["Hub<br/>sequence · fan-out · drain"]
        end
        subgraph WSS2 ["Pod B"]
            Reg2["Registry (self heartbeat)"]
            Watcher2["Membership Watcher"]
            Ring2["Hash Ring (self-check)"]
            Router2["Router<br/>PrepareRegister before upgrade"]
            Manager2["Manager<br/>Room Lease · Sequence Floor"]
            Hub2["Hub<br/>sequence · fan-out · drain"]
        end
        More["... more pods<br/>when scaled"]
    end

    RedisMembers[("Redis<br/>wss:member:*")]
    RedisLeases[("Redis<br/>wss:room:lease:{roomID}<br/>owner_addr · token")]
    RedisSeqFloor[("Redis<br/>wss:room:seqfloor:{roomID}<br/>last issued sequence")]

    Client == "WS Upgrade" ==> Router

    Reg1 -- "SET membership_token EX 30s" --> RedisMembers
    Reg2 -- "SET membership_token EX 30s" --> RedisMembers

    RedisMembers -- "keyspace notify + SCAN" --> Watcher_G
    RedisMembers -- "keyspace notify + SCAN" --> Watcher1
    RedisMembers -- "keyspace notify + SCAN" --> Watcher2

    Watcher_G -- "ring.Set(addrs)" --> Hashring
    Watcher1 -- "ring.Set(addrs)" --> Ring1
    Watcher2 -- "ring.Set(addrs)" --> Ring2

    Router -- "Locate(roomID)" --> Hashring
    Router == "프록시" ==> WSS1
    Router == "프록시" ==> WSS2
    Router -. "same logic" .-> More
    WSS1 -- "self-check Locate(roomID)" --> Ring1
    WSS2 -- "self-check Locate(roomID)" --> Ring2
    Ring1 --> Router1
    Ring2 --> Router2
    Router1 -- "PrepareRegister" --> Manager1
    Router2 -- "PrepareRegister" --> Manager2
    Manager1 -- "acquire/renew/release" --> RedisLeases
    Manager2 -- "acquire/renew/release" --> RedisLeases
    Manager1 -- "read before Hub start<br/>SETMAX on Persist failure" --> RedisSeqFloor
    Manager2 -- "read before Hub start<br/>SETMAX on Persist failure" --> RedisSeqFloor
    Manager1 --> Hub1
    Manager2 --> Hub2
    Hub1 -. "persist drain 완료 후 lease release" .-> Manager1
    Hub2 -. "persist drain 완료 후 lease release" .-> Manager2
