flowchart TB
    subgraph External ["External Layer"]
        direction LR
        Client["Web Browser"]
    end

    subgraph K8s ["Kubernetes Namespace (dev/test)"]
        direction TB

        Ingress["Ingress<br/>/ · /api · /ws-api · /ws"]

        subgraph Edge ["Edge Deployments"]
            direction LR
            FE["Frontend Deployment<br/>replicas: dev/test=1"]
            Docs["Swagger UI Deployment<br/>OpenAPI docs"]
            WSGW["WS Gateway Deployment<br/>replicas: dev=1, test=2"]
            AGW["API Gateway Deployment<br/>replicas: dev=1, test=2"]

            AGW -- "Internal HTTP" --> WSGW
        end

        subgraph Core ["Core Deployments"]
            direction LR
            WSS["WebSocket Service Deployment<br/>replicas: dev=1, test=2<br/>qa: HPA planned"]
            US["User Service Deployment<br/>Headless Service<br/>replicas: dev=1, test=2"]
            CS["Chat Service Deployment<br/>Headless Service<br/>replicas: dev=1, test=2"]
        end

        subgraph Data ["Local Data Layer"]
            direction LR
            PG[("PostgreSQL<br/>Deployment")]
            MG[("MongoDB<br/>Deployment")]
            RD[("Redis<br/>Deployment")]
        end

        subgraph Observability ["Observability Layer"]
            direction LR
            Alloy["Alloy"]
            Prometheus[("Prometheus")]
            Loki[("Loki")]
            Tempo[("Tempo")]
            Pyroscope[("Pyroscope")]
            Grafana["Grafana"]

            Alloy -- "metrics" --> Prometheus
            Alloy -- "logs" --> Loki
            Alloy -- "traces" --> Tempo
            Prometheus & Loki & Tempo & Pyroscope --> Grafana
        end
    end

    Client == "HTTP / WebSocket" ==> Ingress
    Ingress == "/" ==> FE
    Ingress == "/api" ==> AGW
    Ingress == "/ws-api, /ws" ==> WSGW
    Ingress == "/docs" ==> Docs
    Ingress == "/grafana" ==> Grafana

    WSGW -- "L7 Proxy<br/>room_id hashing" --> WSS

    AGW -- "gRPC" --> US
    AGW -- "gRPC" --> CS

    WSS -- "gRPC" --> US
    WSS -- "gRPC" --> CS

    US --> PG
    CS --> MG
    AGW --> RD
    WSGW --> RD
    WSS --> RD

    Alloy -. "pull: pod logs" .-> AGW
    Alloy -. "pull: pod logs" .-> WSGW
    Alloy -. "pull: pod logs" .-> WSS
    Alloy -. "pull: pod logs" .-> US
    Alloy -. "pull: pod logs" .-> CS

    AGW & WSGW & WSS & US & CS -. "push: traces, metrics" .-> Alloy
    AGW & WSGW & WSS & US & CS -. "push: profiles" .-> Pyroscope
