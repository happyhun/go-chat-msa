flowchart TB
    Start([bootstrap.sh 시작])

    Env["K8S_ENV 선택<br/>dev 기본, test/e2e 가능"]
    NS["Namespace 결정<br/>go-chat-dev 또는 go-chat-test"]

    Foundation["1. foundation apply<br/>Secret · Postgres · Mongo · Redis"]
    DataWait["2. data layer rollout wait<br/>Postgres/Mongo/Redis Ready"]

    ObservabilityCM["3. observability ConfigMap 생성<br/>Alloy/Prometheus/Loki/Tempo/Pyroscope/Grafana 설정"]
    Observability["4. observability apply<br/>Alloy · Prometheus · Grafana<br/>Loki · Tempo · Pyroscope"]
    ObsWait["5. observability rollout wait<br/>telemetry 수신 대상 준비"]

    MigrationCM["6. migration ConfigMap 생성<br/>db/migrations/postgres<br/>db/migrations/mongo"]
    MigrationJob["7. migration Job 재생성<br/>postgres-migrate · mongo-migrate"]
    MigrationWait{"8. migration 완료?"}

    OpenAPICM["9. OpenAPI ConfigMap 생성<br/>Swagger UI spec"]
    Apps["10. apps apply<br/>App ConfigMap · Deployment · Service · Ingress"]
    BackendRestart["11. backend rollout restart/wait<br/>mounted config 반영"]
    EdgeRestart["12. edge rollout restart/wait"]
    Done([K8s dev/test baseline ready])

    Fail["중단<br/>describe/logs 확인 후 수정"]

    Start --> Env --> NS --> Foundation --> DataWait --> ObservabilityCM --> Observability --> ObsWait
    ObsWait --> MigrationCM --> MigrationJob --> MigrationWait
    MigrationWait -- "yes" --> OpenAPICM --> Apps --> BackendRestart --> EdgeRestart --> Done
    MigrationWait -- "no" --> Fail
