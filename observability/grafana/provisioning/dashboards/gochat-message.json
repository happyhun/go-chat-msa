    {
      "id": 16,
      "title": "Out of Order and Queue Overflows",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(gochat_ws_out_of_order_total{namespace=~\"$namespace\",pod=~\"$pod\",node=~\"$node\"}[$__rate_interval])) or on() vector(0)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "out of order"
        },
        {
          "expr": "sum(rate(gochat_ws_send_queue_overflows_total{namespace=~\"$namespace\",pod=~\"$pod\",node=~\"$node\"}[$__rate_interval])) or on() vector(0)",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "send queue overflow"
        },
        {
          "expr": "histogram_quantile(0.99, sum by(le) (rate(gochat_ws_reorder_span_seconds_bucket{namespace=~\"$namespace\",pod=~\"$pod\",node=~\"$node\"}[$__rate_interval])))",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "reorder span P99"
        },
        {
          "expr": "(sum(rate(gochat_ws_reorder_span_seconds_count{namespace=~\"$namespace\",pod=~\"$pod\",node=~\"$node\"}[$__rate_interval])) - sum(rate(gochat_ws_reorder_span_seconds_bucket{namespace=~\"$namespace\",pod=~\"$pod\",node=~\"$node\",le=\"0.001\"}[$__rate_interval]))) or on() vector(0)",
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "out of order >1ms"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "unit": "ops",
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "reorder span P99"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      },
      "description": "Delivery order and per-session queue overflow. Most reorders are sub-millisecond gaps between pods; the reorder span distribution sets the sync rewind margin. Send queue overflow closes the affected session so the client reconnects and syncs."
    },
