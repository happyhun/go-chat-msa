flowchart TB
    Client["Client"]

    subgraph WSGateway ["WS Gateway"]
        direction TB
        Router["Router"]
        Hashring["Consistent Hashing"]
        Watcher_G["Membership Watcher"]
    end

    subgraph WS_Cluster ["WebSocket Service Deployment"]
        direction TB
        subgraph WSS1 ["Pod A"]
            Reg1["Registry (self heartbeat)"]
            Watcher1["Membership Watcher"]
            Ring1["Hash Ring (self-check)"]
        end
        subgraph WSS2 ["Pod B"]
            Reg2["Registry (self heartbeat)"]
            Watcher2["Membership Watcher"]
            Ring2["Hash Ring (self-check)"]
        end
        More["... more pods<br/>when scaled"]
    end

    Redis[("Redis<br/>wss:member:*")]

    Client == "WS Upgrade" ==> Router

    Reg1 -- "SET lease_token EX ttl" --> Redis
    Reg2 -- "SET lease_token EX ttl" --> Redis

    Redis -- "keyspace notify + SCAN" --> Watcher_G
    Redis -- "keyspace notify + SCAN" --> Watcher1
    Redis -- "keyspace notify + SCAN" --> Watcher2

    Watcher_G -- "ring.Set(addrs)" --> Hashring
    Watcher1 -- "ring.Set(addrs)" --> Ring1
    Watcher2 -- "ring.Set(addrs)" --> Ring2

    Router -- "Locate(roomID)" --> Hashring
    Router == "프록시" ==> WSS1
    Router == "프록시" ==> WSS2
    Router -. "same logic" .-> More
    WSS1 -- "self-check Locate(roomID)" --> Ring1
    WSS2 -- "self-check Locate(roomID)" --> Ring2
