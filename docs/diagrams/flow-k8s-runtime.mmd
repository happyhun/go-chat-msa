flowchart TB
    subgraph External ["External Layer"]
        direction LR
        Client["Web Browser"]
    end

    subgraph K8s ["Kubernetes Namespace (dev/test/qa)"]
        direction TB

        Ingress["Ingress<br/>/ · /api · /ws-api · /ws"]

        subgraph Edge ["Edge Deployments"]
            direction LR
            FE["Frontend Deployment<br/>replicas: 1"]
            Docs["Swagger UI Deployment<br/>OpenAPI docs"]
            WSGW["WS Gateway Deployment<br/>dev/qa=1, test=2"]
            AGW["API Gateway Deployment<br/>dev/qa=1, test=2"]

            AGW -- "Internal HTTP" --> WSGW
        end

        subgraph Core ["Core Deployments"]
            direction LR
            WSS["WebSocket Service Deployment<br/>dev/test=2, qa=HPA 1→2<br/>Room Lease · Sequence Floor · HPA Handoff"]
            US["User Service Deployment<br/>Headless Service<br/>dev/qa=1, test=2"]
            CS["Chat Service Deployment<br/>Headless Service<br/>dev/qa=1, test=2"]
        end

        subgraph Data ["Local Data Layer"]
            direction LR
            PG[("PostgreSQL<br/>Deployment")]
            MG[("MongoDB<br/>Deployment")]
            RD[("Redis<br/>Deployment<br/>Membership · Room Lease · Sequence Floor")]
        end

        subgraph Observability ["Observability Layer"]
            direction LR
            Alloy["Alloy"]
            Prometheus[("Prometheus")]
            Loki[("Loki")]
            Tempo[("Tempo")]
            Pyroscope[("Pyroscope")]
            Grafana["Grafana"]
            Adapter["Prometheus Adapter<br/>qa custom metrics"]

            Alloy -- "metrics" --> Prometheus
            Alloy -- "logs" --> Loki
            Alloy -- "traces" --> Tempo
            Prometheus -- "gochat_ws_connections_active" --> Adapter
            Prometheus & Loki & Tempo & Pyroscope --> Grafana
        end

        subgraph Load ["Load Jobs"]
            direction LR
            C10K["dev-load<br/>k6-c10k Job x4"]
            HPAK6["qa-load<br/>k6-hpa Job"]
        end

        subgraph Autoscaling ["Autoscaling"]
            direction LR
            HPA["HPA websocket-service<br/>qa only · min=1 max=2"]
        end
    end

    Client == "HTTP / WebSocket" ==> Ingress
    Ingress == "/" ==> FE
    Ingress == "/api" ==> AGW
    Ingress == "/ws-api, /ws" ==> WSGW
    Ingress == "/docs" ==> Docs
    Ingress == "/grafana" ==> Grafana

    WSGW -- "L7 Proxy<br/>room_id hashing<br/>Pod IP direct" --> WSS

    AGW -- "gRPC" --> US
    AGW -- "gRPC" --> CS

    WSS -- "gRPC" --> US
    WSS -- "gRPC" --> CS

    US --> PG
    CS --> MG
    AGW --> RD
    WSGW --> RD
    WSS --> RD

    Adapter -. "custom.metrics.k8s.io" .-> HPA
    HPA -. "scaleTargetRef" .-> WSS
    C10K -. "internal HTTP/WebSocket" .-> AGW
    C10K -. "internal HTTP/WebSocket" .-> WSGW
    HPAK6 -. "internal HTTP/WebSocket" .-> AGW
    HPAK6 -. "internal HTTP/WebSocket" .-> WSGW

    Alloy -. "pull: pod logs" .-> AGW
    Alloy -. "pull: pod logs" .-> WSGW
    Alloy -. "pull: pod logs" .-> WSS
    Alloy -. "pull: pod logs" .-> US
    Alloy -. "pull: pod logs" .-> CS

    AGW & WSGW & WSS & US & CS -. "push: traces, metrics" .-> Alloy
    AGW & WSGW & WSS & US & CS -. "push: profiles" .-> Pyroscope
